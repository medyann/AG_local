# AlphaGenome Web Deployment - Environment Variables
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env

# ─── Required ─────────────────────────────────────────────────────────────────

# Hugging Face API token (required to download model weights)
# 1. Create account at https://huggingface.co
# 2. Accept model terms at https://huggingface.co/google/alphagenome-all-folds
# 3. Create token at https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

# ─── Optional ─────────────────────────────────────────────────────────────────

# Model version: all_folds (default), fold_0, fold_1, fold_2, fold_3, fold_4
ALPHAGENOME_MODEL_VERSION=all_folds

# Whether to load model on startup (true/false)
PRELOAD_MODEL=true

# Server host and port
HOST=0.0.0.0
PORT=8000
